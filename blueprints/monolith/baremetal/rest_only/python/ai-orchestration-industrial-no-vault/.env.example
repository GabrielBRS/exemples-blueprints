# Copie para .env e ajuste. NUNCA versione o .env real.

# Qual orquestrador o composition root monta no boot:
#   echo      -> dev/teste, sem LLM (default)
#   langgraph -> grafo plan -> execute -> review (LangGraph)
#   autogen   -> time planner + executor em RoundRobin (AutoGen)
ORCHESTRATOR=echo

# LLM OpenAI-compatible (vLLM, Ollama, LM Studio, OpenAI...).
# On-premise first: aponte pro seu vLLM/Ollama.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=nao-usado-em-servidor-local

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

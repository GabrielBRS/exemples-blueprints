# Copie para .env e ajuste. NUNCA versione o .env real.

# Ambiente: development (default) | staging | production
# - development        -> segredos vem do ambiente/.env (abaixo)
# - staging/production  -> segredos vem do Vault (bloco VAULT_*), fail-closed
APP_ENV=development

# --- Nao-segredos: SEMPRE lidos do ambiente, em qualquer APP_ENV ---
HOST=0.0.0.0
PORT=8080
DB_MAX_CONNECTIONS=10
DB_ACQUIRE_TIMEOUT_SECS=5
RUST_LOG=info,tower_http=debug,sqlx=warn

# --- Segredos em development (ignorados quando APP_ENV=staging|production) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scaffold

# --- Vault (usado quando APP_ENV=staging|production) ---
# Nao setar em dev. VAULT_ROLE_ID/VAULT_SECRET_ID sao a credencial de bootstrap
# do AppRole, injetada pelo orquestrador (Secret do k3s / systemd), nunca no git.
# VAULT_ADDR=https://vault.internal:8200
# VAULT_KV_MOUNT=secret
# VAULT_SECRET_PATH=backend/config
# VAULT_ROLE_ID=...
# VAULT_SECRET_ID=...
